# Agent / LLM
MODEL_ID=
AGENT_MODEL_ID=
AGENT_BASE_URL=
ANTHROPIC_BASE_URL=
AGENT_API_KEY=
AGENT_MAX_TOKENS=
AGENT_TEMPERATURE=
AGENT_TOP_P=
