# Built-in tools
# true 表示该工具会提供给模型；false 表示不展示给模型且调用时拒绝。
BUILTIN_TOOLS_ENABLED=true
BUILTIN_TOOL_TODO_WRITE_ENABLED=true
BUILTIN_TOOL_BACKGROUND_RUN_ENABLED=true
BUILTIN_TOOL_BROADCAST_ENABLED=true
BUILTIN_TOOL_CHECK_BACKGROUND_ENABLED=true
BUILTIN_TOOL_CLAIM_TASK_ENABLED=true
BUILTIN_TOOL_COMPRESS_ENABLED=true
BUILTIN_TOOL_EDIT_FILE_ENABLED=true
BUILTIN_TOOL_IDLE_ENABLED=true
BUILTIN_TOOL_LIST_TEAMMATES_ENABLED=true
BUILTIN_TOOL_LOAD_SKILL_ENABLED=true
BUILTIN_TOOL_PLAN_APPROVAL_ENABLED=true
BUILTIN_TOOL_READ_FILE_ENABLED=true
BUILTIN_TOOL_READ_INBOX_ENABLED=true
BUILTIN_TOOL_SEND_MESSAGE_ENABLED=true
BUILTIN_TOOL_SHUTDOWN_REQUEST_ENABLED=true
BUILTIN_TOOL_SPAWN_TEAMMATE_ENABLED=true
BUILTIN_TOOL_TASK_ENABLED=true
BUILTIN_TOOL_TASK_BIND_WORKTREE_ENABLED=true
