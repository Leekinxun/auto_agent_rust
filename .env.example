BUILTIN_TOOL_WORKTREE_REMOVE_ENABLED=true
BUILTIN_TOOL_WORKTREE_RUN_ENABLED=true
BUILTIN_TOOL_WORKTREE_STATUS_ENABLED=true
BUILTIN_TOOL_WRITE_FILE_ENABLED=true

# HITL
# 默认关闭；需要人工审批工具调用时再打开。
HITL_ENABLED=false
HITL_TIMEOUT_SECONDS=300

# MCP
