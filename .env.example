TZ=Asia/Shanghai
HOST_PORT=18000

# Agent / LLM
MODEL_ID=
AGENT_MODEL_ID=
AGENT_BASE_URL=
ANTHROPIC_BASE_URL=
AGENT_API_KEY=
AGENT_MAX_TOKENS=
AGENT_TEMPERATURE=
AGENT_TOP_P=
AGENT_MAX_ITERATIONS=8
AGENT_SUBAGENT_MAX_ITERATIONS=30
AGENT_AUTO_COMPACT_TOKEN_THRESHOLD=60000

# Built-in file tools
# true 表示该工具会提供给模型；false 表示不展示给模型且调用时拒绝。
BUILTIN_TOOLS_ENABLED=true
BUILTIN_TOOL_READ_FILE_ENABLED=false
BUILTIN_TOOL_WRITE_FILE_ENABLED=false
BUILTIN_TOOL_EDIT_FILE_ENABLED=false

# HITL
# 默认关闭；需要人工审批工具调用时再打开。
HITL_ENABLED=false
HITL_TIMEOUT_SECONDS=300

# MCP
MCP_BASE_URL=
MCP_TIMEOUT=
MCP_CONNECT_TIMEOUT=

# Logging
LOG_DIR=logs

# Server / CORS
SERVER_HOST=0.0.0.0
SERVER_PORT=18000
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
